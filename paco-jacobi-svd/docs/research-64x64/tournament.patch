+    // Research-only 64x64 resident, one AIV per matrix, tournament ordering.
+    __aicore__ inline void RunResidentTournament(__gm__ float *input, __gm__ float *output,
+        int32_t m, int64_t matElems, int32_t maxSweeps)
+    {
+        GlobalTensor<float> in, out;
+        in.SetGlobalBuffer(input + static_cast<int64_t>(m) * matElems);
+        out.SetGlobalBuffer(output + static_cast<int64_t>(m) * matElems);
+        LoadRows(tile_, in, 0, 4096);
+        LocalTensor<float> cur = tile_;
+        LocalTensor<float> next = tile_[4096];
+        Duplicate(red_, 0.0f, 192);
+        const BinaryRepeatParams br{1, 1, 0, 8, 8, 1};
+        for (int32_t sweep = 0; sweep < maxSweeps; ++sweep) {
+            Duplicate(ls_, 0.0f, 64);
+            for (int32_t round = 0; round < 63; ++round) {
+                LocalTensor<float> u = cur;
+                LocalTensor<float> v = cur[2048];
+                Mul(prod3_, u, u, 2048);
+                WholeReduceSum(red_[0], prod3_, 64, 32, 1, 1, 8);
+                Mul(prod3_, v, v, 2048);
+                WholeReduceSum(red_[64], prod3_, 64, 32, 1, 1, 8);
+                Mul(prod3_, u, v, 2048);
+                WholeReduceSum(red_[128], prod3_, 64, 32, 1, 1, 8);
+                Mul(scls_, red_[0], red_[64], 64);
+                Sqrt(scls_, scls_, 64);
+                Muls(thrV_, scls_, 1e-6f, 64);
+                Abs(absV_, red_[128], 64);
+                Compare(mask_, absV_, thrV_, CMPMODE::GT, 64);
+                Select(actV_, mask_, onesV_, zerosV_, SELMODE::VSEL_TENSOR_TENSOR_MODE, 64);
+                Max(ls_, ls_, actV_, 64);
+                Sub(diffV_, red_[64], red_[0], 64);
+                Select(diffV_, mask_, diffV_, zerosV_, SELMODE::VSEL_TENSOR_TENSOR_MODE, 64);
+                Muls(denV_, red_[128], 2.0f, 64);
+                Select(denV_, mask_, denV_, onesV_, SELMODE::VSEL_TENSOR_TENSOR_MODE, 64);
+                Div(tauV_, diffV_, denV_, 64);
+                Abs(diffV_, tauV_, 64);
+                Mul(svV_, tauV_, tauV_, 64);
+                Adds(svV_, svV_, 1.0f, 64);
+                Sqrt(svV_, svV_, 64);
+                Add(denV_, diffV_, svV_, 64);
+                Div(tV_, onesV_, denV_, 64);
+                Compare(mask2_, tauV_, zerosV_, CMPMODE::GE, 64);
+                Muls(tmpV_, tV_, -1.0f, 64);
+                Select(tV_, mask2_, tV_, tmpV_, SELMODE::VSEL_TENSOR_TENSOR_MODE, 64);
+                Select(tV_, mask_, tV_, zerosV_, SELMODE::VSEL_TENSOR_TENSOR_MODE, 64);
+                Mul(tmpV_, tV_, tV_, 64);
+                Adds(tmpV_, tmpV_, 1.0f, 64);
+                Sqrt(tmpV_, tmpV_, 64); // invCs
+                Div(csV_, onesV_, tmpV_, 64);
+                Mul(snV_, csV_, tV_, 64);
+                Muls(snV_, snV_, -1.0f, 64);
+                Brcb(rowA_[0], csV_, 4, {1, 8});
+                Brcb(rowA_[256], snV_, 4, {1, 8});
+                Brcb(rowA_[512], tmpV_, 4, {1, 8});
+                Brcb(rowA_[768], tV_, 4, {1, 8});
+                Mul(u, u, rowA_[0], 64, 32, br);
+                MulAddDst(u, v, rowA_[256], 64, 32, br);
+                Mul(v, v, rowA_[512], 64, 32, br);
+                MulAddDst(v, u, rowA_[768], 64, 32, br);
+
+                // Circle schedule: A'=[A0,B0,A1..A30], B'=[B1..B31,A31].
+                Adds(next[0], cur[0], 0.0f, 64);
+                Adds(next[64], cur[2048], 0.0f, 64);
+                Adds(next[128], cur[64], 0.0f, 30 * 64);
+                Adds(next[2048], cur[2112], 0.0f, 31 * 64);
+                Adds(next[4032], cur[1984], 0.0f, 64);
+                LocalTensor<float> swap = cur; cur = next; next = swap;
+            }
+            WholeReduceMax(red_[200], ls_, 64, 1, 1, 1, 8, ReduceOrder::ORDER_ONLY_VALUE);
+            if (red_.GetValue(200) == 0.0f) break;
+        }
+        StoreRows(out, 0, cur, 4096);
+    }
